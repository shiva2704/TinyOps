@'
# Terraform local files and state
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraformrc
terraform.rc

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node.js, if needed later
node_modules/

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db
'@ | Set-Content -LiteralPath ".gitignore" -Encoding utf8